terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "{{ .AWSRegion }}"
}

resource "aws_s3_bucket" "{{ .ResourceName }}" {
  bucket = "{{ .BucketName }}"
}

resource "aws_s3_bucket_ownership_controls" "{{ .ResourceName }}" {
  bucket = aws_s3_bucket.{{ .ResourceName }}.id

  rule {
    object_ownership = "{{ .ObjectOwnership }}" # BucketOwnerPreferred by default to support ACLs
  }
}

resource "aws_s3_bucket_acl" "{{ .ResourceName }}" {
  depends_on = [aws_s3_bucket_ownership_controls.{{ .ResourceName }}]
  bucket     = aws_s3_bucket.{{ .ResourceName }}.id
  acl        = "{{ .ACL }}"
}
